<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LahLahVoice" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/sand</item>
        <item name="android:navigationBarColor">@color/sand</item>
        <item name="android:windowBackground">@color/sand</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="KeyboardKey">
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/key</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
