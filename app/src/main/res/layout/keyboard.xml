<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/sand"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="start"
        android:minHeight="44dp"
        android:text="@string/keyboard_tap_to_speak"
        android:textColor="@color/muted"
        android:textSize="15sp" />

    <Button
        android:id="@+id/mic"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/mic_button"
        android:contentDescription="@string/keyboard_mic"
        android:text="@string/keyboard_mic_glyph"
        android:textColor="@android:color/white"
        android:textSize="34sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/switchKeyboard"
            style="@style/KeyboardKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/keyboard_switch"
            android:text="@string/keyboard_switch_glyph" />

        <Button
            android:id="@+id/space"
            style="@style/KeyboardKey"
            android:layout_width="0dp"
            android:layout_weight="3"
            android:text="@string/keyboard_space" />

        <Button
            android:id="@+id/backspace"
            style="@style/KeyboardKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/keyboard_delete"
            android:text="@string/keyboard_delete_glyph" />

        <Button
            android:id="@+id/enter"
            style="@style/KeyboardKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/keyboard_enter"
            android:text="@string/keyboard_enter_glyph" />
    </LinearLayout>
</LinearLayout>
